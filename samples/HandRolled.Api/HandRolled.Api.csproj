<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TenantGuard.EntityFrameworkCore/TenantGuard.EntityFrameworkCore.csproj" />
    <!-- The analyzers, which the TenantGuard.EntityFrameworkCore package brings with it. -->
    <ProjectReference Include="../../src/TenantGuard.Analyzers/TenantGuard.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
