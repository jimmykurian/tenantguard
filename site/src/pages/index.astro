// The home page (ADR 0028): a page of its own inside Starlight's frame, so it keeps the
// header, search and theme switch. Every other page comes from docs/.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const repo = 'https://github.com/jimmykurian/tenantguard';
const install = 'dotnet add package TenantGuard.EntityFrameworkCore';

const checkpoints = [
  {
    when: 'At build',
    what: 'Roslyn analyzers',
    ids: 'TG001 to TG005',
    text: "Flag IgnoreQueryFilters(), raw SQL without a tenant predicate and a framework's own filter switch, unless the code says why.",
    href: '/reference/analyzers/',
  },
  {
    when: 'At startup',
    what: 'Model rules',
    ids: 'TGM001 to TGM014',
    text: 'Fail the host when a tenant-scoped entity has no query filter, or its filter is frozen to one tenant.',
    href: '/reference/rules/',
  },
  {
    when: 'On SaveChanges',
    what: 'Write guard',
    ids: 'TenantIsolationViolationException',
    text: "Throws before the database sees a write, move or delete of another tenant's row.",
    href: '/reference/write-guard/',
  },
  {
    when: 'In tests',
    what: 'Isolation probe',
    ids: '7 checks per entity',
    text: "Seeds a row per tenant and proves, entity by entity, that one tenant can't reach another's.",
    href: '/reference/probe/',
  },
];

const stats = [
  { number: '5', label: 'analyzers', detail: 'TG001 to TG005, at build' },
  { number: '14', label: 'model rules', detail: 'TGM001 to TGM014, at startup' },
  { number: '3', label: 'write states guarded', detail: 'Added, Modified and Deleted, on SaveChanges' },
  { number: '7', label: 'probe checks', detail: 'per entity, for every pair of tenants, in tests' },
];

const leaks = [
  ['An entity with a tenant property and no filter', '', 'Yes: TGM001', '', 'Yes: the probe stops on the rule error'],
  ['A filter that captured a local or a constant', '', 'Yes: TGM003, TGM004', '', 'Yes, on the rule error'],
  ['IgnoreQueryFilters() without a reason', 'Yes: TG001', '', '', ''],
  ["Raw SQL that doesn't compare the tenant column with a value", "Yes: TG002, or TG004 when it's built at runtime", '', '', ''],
  ["A framework's own filter switch, such as ABP's IDataFilter.Disable<IMultiTenant>()", 'Yes: TG005', '', '', ''],
  ["A write, move or delete of another tenant's row", '', '', 'Yes: TenantIsolationViolationException, before the database', 'Yes: UpdateGuard, InsertGuard, DeleteGuard'],
  ["A change to only the owned part of another tenant's row, such as order.Shipping", '', '', 'Yes: checked through its owner', ''],
  ['A bulk ExecuteDelete or ExecuteUpdate across tenants', '', '', 'Not seen: it skips SaveChanges', 'Yes: BulkIsolation'],
  ['A new entity added months later', '', 'Yes: every rule runs on every entity', "Yes, once it's tenant-scoped", 'Yes: every tenant-scoped entity is probed'],
];
---

<StarlightPage
  frontmatter={{
    title: 'Prove an EF Core multi-tenant model leaks nothing',
    description: 'Prove an EF Core multi-tenant model leaks nothing.',
    template: 'splash',
    tableOfContents: false,
    editUrl: false,
  }}
>
  <section class="tg-hero not-content" aria-labelledby="tg-hero-title">
    <p class="tg-eyebrow">For EF Core 10 and 11 · Apache-2.0</p>
    <h1 id="tg-hero-title">Prove one tenant can't see another's data.</h1>
    <p class="tg-lede">
      Query filters isolate tenants until someone forgets one, switches it off or writes
      around it. TenantGuard catches each of those at build, at startup, on
      <code>SaveChanges</code> and in your tests, on Finbuckle, any tenancy package or
      hand-rolled filters.
    </p>
    <div class="tg-actions">
      <a class="tg-button tg-primary" href="/guides/">Get started</a>
      <a class="tg-button" href="/guides/use-case/">Why use it</a>
      <a class="tg-button" href={repo}>GitHub</a>
    </div>
    <div class="tg-install">
      <span class="tg-install-label">Install</span>
      <code>{install}</code>
    </div>
  </section>

  <section class="tg-section not-content" aria-labelledby="tg-checkpoints">
    <h2 id="tg-checkpoints">Four checkpoints</h2>
    <p>Each kind of leak fails at the first moment it can: in the pull request, at startup, or on the first bad save.</p>
    <ol class="tg-steps">
      {
        checkpoints.map((step, index) => (
          <li class="tg-step">
            <span class="tg-step-index" aria-hidden="true">{index + 1}</span>
            <span class="tg-step-when">{step.when}</span>
            <a class="tg-step-what" href={step.href}>{step.what}</a>
            <span class="tg-step-ids">{step.ids}</span>
            <span class="tg-step-text">{step.text}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="tg-section not-content" aria-labelledby="tg-in-action">
    <h2 id="tg-in-action">See it in action</h2>
    <p>One app, four mistakes, and the checkpoint that catches each.</p>
    <img
      class="tg-walkthrough"
      src="/tenantguard-walkthrough.svg"
      width="1110"
      height="610"
      alt="A terminal walkthrough in four steps. At build, dotnet build warns TG001 on an IgnoreQueryFilters call. At startup, dotnet run fails with TGM001: Invoice has a tenant property but no query filter references it. On SaveChanges, TenantGuard blocks an Invoice for tenant acme added while the current tenant is globex, and throws TenantIsolationViolationException. In tests, the isolation probe reports that Customer's read, find and bulk delete checks failed."
    />
  </section>

  <section class="tg-section not-content" aria-label="TenantGuard in numbers">
    <ul class="tg-stats">
      {
        stats.map((stat) => (
          <li class="tg-stat">
            <span class="tg-stat-number">{stat.number}</span>
            <span class="tg-stat-label">{stat.label}</span>
            <span class="tg-stat-detail">{stat.detail}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="tg-section not-content" aria-labelledby="tg-matrix">
    <h2 id="tg-matrix">What each checkpoint catches</h2>
    <div class="tg-table">
      <table>
        <thead>
          <tr>
            <th scope="col">Leak</th>
            <th scope="col">At build</th>
            <th scope="col">At startup</th>
            <th scope="col">On SaveChanges</th>
            <th scope="col">In tests</th>
          </tr>
        </thead>
        <tbody>
          {
            leaks.map(([leak, ...cells]) => (
              <tr>
                <th scope="row">{leak}</th>
                {cells.map((cell) => <td>{cell || 'No'}</td>)}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="tg-section tg-next not-content" aria-labelledby="tg-why">
    <h2 id="tg-why">Why you'd use it</h2>
    <p>
      An invoicing app with every tenant in one database starts with a filter on every
      entity. A year of ordinary changes later, a new entity ships without one, a support
      report adds <code>IgnoreQueryFilters()</code>, an import job saves acme's rows as
      globex's, and a refactor freezes a filter to the first tenant. None of them fails the
      build or the tests. With TenantGuard, each one does.
    </p>
    <div class="tg-cards">
      <a class="tg-card" href="/guides/use-case/">
        <strong>Read the use case</strong>
        <span>The four leaks, month by month, and where TenantGuard catches each.</span>
      </a>
      <a class="tg-card" href="/guides/">
        <strong>Get started</strong>
        <span>Five lines of registration, with hand-rolled filters or Finbuckle.</span>
      </a>
      <a class="tg-card" href="/overview/">
        <strong>Read the overview</strong>
        <span>The packages, what each checks, and where to go next.</span>
      </a>
    </div>
  </section>
</StarlightPage>

