<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TenantGuardRuntimeTargetFrameworks)</TargetFrameworks>
    <RootNamespace>TenantGuard</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>TenantGuard.EntityFrameworkCore</PackageId>
    <Description>Proves an EF Core multi-tenant model leaks nothing: startup model validation, a SaveChanges guard and Roslyn analyzers. Works with Finbuckle, other tenancy packages, or hand-rolled query filters.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- The analyzers ship inside this package too (SPEC 2), built first and packed under analyzers/. -->
  <ItemGroup>
    <ProjectReference Include="../TenantGuard.Analyzers/TenantGuard.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../TenantGuard.Analyzers/bin/$(Configuration)/$(TenantGuardAnalyzerTargetFramework)/TenantGuard.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TenantGuard.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="TenantGuard.Testing" />
    <InternalsVisibleTo Include="TenantGuard.Testing.Tests" />
    <InternalsVisibleTo Include="TenantGuard.BehaviorPins" />
  </ItemGroup>

</Project>
