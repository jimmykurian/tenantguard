<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs inside the app's process: dotnet exec starts it under the app's .deps.json and
    .runtimeconfig.json (ADR 0024), so EF Core, the provider, the Design package and TenantGuard
    resolve to the app's own copies. TenantGuard.Tool ships it in payload/<tfm>/.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(TenantGuardRuntimeTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <!-- dotnet exec runs it under the app's .runtimeconfig.json and .deps.json, never its own. -->
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RootNamespace>TenantGuard.Tool</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TenantGuard.EntityFrameworkCore/TenantGuard.EntityFrameworkCore.csproj" />
    <!-- Compiled against the floor, so it loads under an app on any EF Core 10 patch (ADR 0033). -->
    <!-- Private: the tool only starts the payload, so Design and its pins don't flow into it. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" VersionOverride="$(TenantGuardEfCoreFloor)" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Condition="'$(TargetFramework)' == 'net10.0'" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" Condition="'$(TargetFramework)' == 'net10.0'" PrivateAssets="all" />
    <!--
      Design 10.0.0 brings this at 4.14.0, which ships a BuildHost-net472 folder as content files; it
      would be copied into the tool. The payload never uses MSBuild workspaces, so its content is left out.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Condition="'$(TargetFramework)' == 'net10.0'" ExcludeAssets="contentFiles" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../TenantGuard.Tool/CommandLine.cs" Link="CommandLine.cs" />
    <Compile Include="../TenantGuard.Tool/ExitCodes.cs" Link="ExitCodes.cs" />
    <Compile Include="../TenantGuard.Tool/ParseResult.cs" Link="ParseResult.cs" />
    <Compile Include="../TenantGuard.Tool/ValidateArguments.cs" Link="ValidateArguments.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TenantGuard.Tool.Tests" />
  </ItemGroup>

</Project>
