<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app ValidateTool.Tests runs dotnet tenantguard validate on: two contexts, one that breaks
       a rule and one with a warning, each from a design-time factory. Not a test project itself. -->
  <PropertyGroup>
    <TargetFrameworks>$(TenantGuardRuntimeTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="xunit.v3" />
    <PackageReference Remove="AwesomeAssertions" />
    <Using Remove="Xunit" />
    <Using Remove="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/TenantGuard.EntityFrameworkCore/TenantGuard.EntityFrameworkCore.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
